apiVersion: v1
kind: Service
metadata:
  name: {{ "{{" }} include "{{chartName}}.fullname" . {{ "}}" }}
  labels:
    {{ "{{" }}- include "{{chartName}}.labels" . | nindent 4 {{ "}}" }}
spec:
  type: ClusterIP
  selector:
    {{ "{{" }}- include "{{chartName}}.selectorLabels" . | nindent 4 {{ "}}" }}
  ports:
    - name: http
      port: {{ "{{" }} .Values.service.port {{ "}}" }}
      targetPort: http
      protocol: TCP
