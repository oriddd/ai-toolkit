{{ "{{" }}- /* Dev / test convenience only. In real environments set credentials.existingSecret to a Secret
       managed by External Secrets, Sealed Secrets or SOPS, and leave credentials.values empty. */{{ "}}" }}
{{ "{{" }}- if and (not .Values.credentials.existingSecret) .Values.credentials.values {{ "}}" }}
apiVersion: v1
kind: Secret
metadata:
  name: {{ "{{" }} include "{{chartName}}.credentialsSecretName" . {{ "}}" }}
  labels:
    {{ "{{" }}- include "{{chartName}}.labels" . | nindent 4 {{ "}}" }}
type: Opaque
stringData:
  {{ "{{" }}- range $key, $value := .Values.credentials.values {{ "}}" }}
  {{ "{{" }} $key {{ "}}" }}: {{ "{{" }} $value | quote {{ "}}" }}
  {{ "{{" }}- end {{ "}}" }}
{{ "{{" }}- end {{ "}}" }}
