package {{basePackage}}.privacy;

import java.time.Instant;
import java.time.OffsetDateTime;
import java.time.ZoneOffset;
import lombok.RequiredArgsConstructor;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.context.annotation.Profile;
import org.springframework.jdbc.core.simple.JdbcClient;
import org.springframework.stereotype.Component;
import org.springframework.transaction.annotation.Transactional;

@Component
@Profile("!component-test")
@RequiredArgsConstructor(onConstructor = @__(@Autowired))
public class RetentionPurger {

    private final JdbcClient jdbc;

    @Transactional(rollbackFor = Exception.class)
    public PurgeResult purge(final Instant cutoff) {
        final OffsetDateTime before = OffsetDateTime.ofInstant(cutoff, ZoneOffset.UTC);
        final int outbox = jdbc.sql("DELETE FROM outbox WHERE published_at IS NOT NULL AND published_at < :cutoff")
                .param("cutoff", before)
                .update();
        final int processed = jdbc.sql("DELETE FROM processed_events WHERE processed_at < :cutoff")
                .param("cutoff", before)
                .update();
        return new PurgeResult(outbox, processed);
    }

    public record PurgeResult(int outboxRows, int processedEvents) {}
}
