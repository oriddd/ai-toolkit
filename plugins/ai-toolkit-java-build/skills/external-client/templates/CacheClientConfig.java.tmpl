package {{basePackage}}.adapter.cache.http;
import {{basePackage}}.spi.cache.CachePort;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.boot.http.client.ClientHttpRequestFactoryBuilder;
import org.springframework.boot.http.client.ClientHttpRequestFactorySettings;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.web.client.RestClient;
/**
 * Vendor configuration of the "http" cache adapter (pluggable-architecture §3): active only when
 * platform.cache.provider=http. Callers depend on the CachePort, never on CacheClient or RestClient.
 * The RestClient is built here and handed to CacheClient directly, so no other bean can pick it up by type.
 */
@Configuration(proxyBeanMethods = false)
@ConditionalOnProperty(prefix = "platform.cache", name = "provider", havingValue = "http")
@EnableConfigurationProperties(HttpCacheProperties.class)
public class CacheClientConfig {
    @Bean
    CachePort httpCachePort(RestClient.Builder restClientBuilder,
                            ClientHttpRequestFactoryBuilder<?> requestFactoryBuilder,
                            ClientHttpRequestFactorySettings requestFactorySettings,
                            HttpCacheProperties props) {
        // RestClient has no timeouts by default — without these a hung dependency hangs the caller.
        // Boot's builder and settings keep the detected HTTP client (pooling) and spring.http.client.*;
        // only the timeouts are per dependency. Redirects are not followed: Boot follows them by default, which would turn a
        // 3xx into a silent success (or a call to another host) instead of the DependencyException CacheClient maps it to.
        ClientHttpRequestFactorySettings settings = requestFactorySettings
                .withConnectTimeout(props.connectTimeout())
                .withReadTimeout(props.readTimeout())
                .withRedirects(ClientHttpRequestFactorySettings.Redirects.DONT_FOLLOW);
        // Boot's auto-configured builder keeps Micrometer observation (metrics + W3C trace propagation)
        RestClient restClient = restClientBuilder.clone()
                .baseUrl(props.baseUrl())
                .requestFactory(requestFactoryBuilder.build(settings))
                .build();
        return new HttpCacheAdapter(new CacheClient(restClient, props), new CacheEntryConverter());
    }
}
