package {{basePackage}}.ratelimit;

import static org.assertj.core.api.Assertions.assertThat;

import org.junit.jupiter.api.Test;
import org.springframework.mock.web.MockHttpServletRequest;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;

class ClientKeyResolverTest {

    private final ClientKeyResolver resolver = new ClientKeyResolver();

    @Test
    void resolve_authenticatedRequest_usesThePrincipalName() {
        final MockHttpServletRequest request = new MockHttpServletRequest();
        request.setUserPrincipal(new UsernamePasswordAuthenticationToken("sub-7", "n/a"));
        request.setRemoteAddr("10.0.0.9");

        assertThat(resolver.resolve(request)).isEqualTo("user:sub-7");
    }

    @Test
    void resolve_anonymousRequest_usesTheRemoteAddressNeverAForwardedHeader() {
        final MockHttpServletRequest request = new MockHttpServletRequest();
        request.setRemoteAddr("10.0.0.9");
        request.addHeader("X-Forwarded-For", "6.6.6.6");

        assertThat(resolver.resolve(request)).isEqualTo("ip:10.0.0.9");
    }
}
