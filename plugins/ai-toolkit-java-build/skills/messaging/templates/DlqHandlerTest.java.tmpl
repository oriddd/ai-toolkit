package {{basePackage}}.messaging;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatCode;

import ch.qos.logback.classic.Level;
import ch.qos.logback.classic.Logger;
import ch.qos.logback.classic.spi.ILoggingEvent;
import ch.qos.logback.core.read.ListAppender;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.slf4j.LoggerFactory;

class DlqHandlerTest {

    private final Logger logger = (Logger) LoggerFactory.getLogger(DlqHandler.class);
    private final ListAppender<ILoggingEvent> appender = new ListAppender<>();
    private final DlqHandler handler = new DlqHandler();

    @BeforeEach
    void attachAppender() {
        appender.start();
        logger.addAppender(appender);
    }

    @AfterEach
    void detachAppender() {
        logger.detachAppender(appender);
    }

    @Test
    void onDlt_deadLetter_logsTheOriginalTopicAtErrorAndNeverThrows() {
        assertThatCode(() -> handler.onDlt("{\"id\":\"inv-1\"}", "invoices")).doesNotThrowAnyException();

        assertThat(appender.list).hasSize(1);
        assertThat(appender.list.get(0).getLevel()).isEqualTo(Level.ERROR);
        assertThat(appender.list.get(0).getFormattedMessage()).contains("DLT_RECEIVED").contains("invoices");
    }

    @Test
    void onDlt_deadLetter_doesNotLogThePayload() {
        handler.onDlt("secret-payload", "invoices");

        assertThat(appender.list.get(0).getFormattedMessage()).doesNotContain("secret-payload");
    }

    @Test
    void onMessage_anyPayload_isAPlaceholderThatDoesNotThrow() {
        assertThatCode(() -> handler.onMessage("{}")).doesNotThrowAnyException();
    }
}
