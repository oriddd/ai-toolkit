-- Matches OutboxEntity.java.tmpl and the processed-events dedupe table of the idempotent consumer (SKILL.md §3, §4).
CREATE TABLE outbox (
    id              uuid         PRIMARY KEY,
    aggregate_type  varchar(100) NOT NULL,
    aggregate_id    varchar(100) NOT NULL,
    event_type      varchar(200) NOT NULL,
    payload         text         NOT NULL,
    traceparent     varchar(55),
    created_at      timestamptz  NOT NULL,
    published_at    timestamptz
);
-- the relay only reads unpublished rows, oldest first: a partial index keeps it small
CREATE INDEX ix_outbox_unpublished ON outbox (created_at) WHERE published_at IS NULL;
-- retention job deletes published rows older than N days
CREATE INDEX ix_outbox_published_at ON outbox (published_at) WHERE published_at IS NOT NULL;

CREATE TABLE processed_events (
    event_id     varchar(64) PRIMARY KEY,   -- INSERT ... ON CONFLICT (event_id) DO NOTHING
    processed_at timestamptz NOT NULL DEFAULT now()
);
