/**
 * Idempotent consumer skeleton — replace `processEvent` and the
 * dedup-store calls with project specifics. Retry / DLT topology: add the `@RetryableTopic` and
 * `@DltHandler` of DlqHandler.java.tmpl to this class (SKILL.md §5).
 * The value is the JSON String the outbox relay sent: configure `StringDeserializer` (SKILL.md §4) and map it
 * with an ObjectMapper inside processEvent. A JsonDeserializer would hand this method an event object
 * (ClassCastException) and break DLT publishing through the StringSerializer template.
 * The event id is the `event-id` record header the outbox relay sends (SKILL.md §3), never a payload field.
 */
@Component
@Profile("!component-test")
@RequiredArgsConstructor(onConstructor = @__(@Autowired))
public class IdempotentConsumer {
    static final String EVENT_ID_HEADER = "event-id";
    private final TransactionTemplate tx;
    private final JdbcClient jdbc;
    @KafkaListener(topics = "${kafka.topics.example.name}",
                   groupId = "${kafka.topics.example.group-id}")
    public void onMessage(ConsumerRecord<String, String> rec, Acknowledgment ack) throws BaseDomainException {
        String eventId = eventId(rec);
        // dedupe insert + business effect commit in ONE transaction (SKILL.md §4). Domain exceptions are checked and
        // TransactionTemplate rolls back on unchecked ones only: roll back explicitly, rethrow once the transaction ended.
        BaseDomainException failure = tx.execute(status -> {
            try {
                if (tryRecord(eventId)) {           // false = already processed — skip the effect
                    processEvent(rec.value());
                }
                return null;
            } catch (BaseDomainException e) {
                status.setRollbackOnly();
                return e;
            }
        });
        if (failure != null) {
            throw failure;
        }
        ack.acknowledge();                          // only after the transaction committed
    }
    /** A record without the header can never be deduplicated: fail it as non-retryable so it goes to the DLT. */
    private String eventId(ConsumerRecord<String, String> rec) {
        Header header = rec.headers().lastHeader(EVENT_ID_HEADER);
        if (header == null) {
            throw new IllegalArgumentException("Record without " + EVENT_ID_HEADER + " header at offset " + rec.offset());
        }
        return new String(header.value(), StandardCharsets.UTF_8);
    }
    /** INSERT ... ON CONFLICT DO NOTHING into processed_events (outbox-migration.sql.tmpl); true if the row was inserted. */
    private boolean tryRecord(String eventId) {
        return jdbc.sql("INSERT INTO processed_events (event_id) VALUES (:id) ON CONFLICT (event_id) DO NOTHING")
                .param("id", eventId)
                .update() == 1;
    }
    /** The business effect: replace with the project's handler; runs inside the dedupe transaction. */
    void processEvent(String payload) throws BaseDomainException { /* TODO */ }
}
