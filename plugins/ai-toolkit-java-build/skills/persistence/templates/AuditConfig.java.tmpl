package {{basePackage}}.config;
import org.springframework.context.annotation.Configuration;
import org.springframework.data.jpa.repository.config.EnableJpaAuditing;
/**
 * Turns on JPA auditing. The AuditorAware bean ("auditorAware") is {@code permission.SecurityAuditorAware}, so
 * reading SecurityContextHolder stays inside permission/ (ArchUnit rule securityHolderLivesInPermissionOnly, code-structure).
 */
@Configuration
@EnableJpaAuditing(auditorAwareRef = "auditorAware")
public class AuditConfig {
}
