package {{basePackage}}.permission;

import {{basePackage}}.exception.{{Domain}}ForbiddenException;
import {{basePackage}}.exception.ExceptionMessages;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

/**
 * Dispatcher: resolves the caller context, routes to the matching strategy and lets it verify access.
 * Mirrors SKILL.md §5. `CallerContext`, `CallerContextResolver` and `PermissionsRegistry` live in this package
 * (SKILL.md §2, §3, §5a); adjust `resourceId` to your resource-id shape (SKILL.md Phase 1 #3).
 */
@Component
@Slf4j
public class PermissionsHandler {

    private final CallerContextResolver callerContextResolver;
    private final PermissionsRegistry permissionsRegistry;

    @Autowired
    public PermissionsHandler(final CallerContextResolver callerContextResolver,
                              final PermissionsRegistry permissionsRegistry) {
        this.callerContextResolver = callerContextResolver;
        this.permissionsRegistry = permissionsRegistry;
    }

    public void handle(final String resourceId) throws {{Domain}}ForbiddenException {
        final CallerContext ctx = callerContextResolver.resolve();
        if (ctx == null) {
            throw ExceptionMessages.callerContextNotFound();
        }
        final PermissionsCheckStrategy strategy = permissionsRegistry.getStrategy(ctx);
        if (strategy == null) {
            throw ExceptionMessages.unrecognizedCallerContext(ctx);
        }
        strategy.verifyPermissions(resourceId);
    }
}
