package {{basePackage}}.exception.constants;
import {{basePackage}}.exception.BadRequestException;
import {{basePackage}}.exception.ConflictException;
import {{basePackage}}.exception.DependencyException;
import {{basePackage}}.exception.ForbiddenException;
import {{basePackage}}.exception.NotFoundException;
import {{basePackage}}.exception.TooManyRequestsException;
import {{basePackage}}.exception.UnavailableException;
import {{basePackage}}.exception.UnsupportedApiVersionException;
import java.text.MessageFormat;
import java.time.Duration;
/**
 * Static catalogue of error codes + message templates. Every domain
 * exception is constructed via a method in this class — never with an
 * inline string. Makes the catalogue greppable for support / runbooks.
 * Templates use {@link MessageFormat} placeholders ({0}, {1}); a literal quote is written ''.
 */
public final class ExceptionMessages {
    private ExceptionMessages() {}

    // Error codes — one per HTTP mapping; the advice copies it to the ProblemDetail "errorCode" property.
    public static final String ERR_BAD_REQUEST = "ERR-BAD-REQUEST";
    public static final String ERR_FORBIDDEN = "ERR-FORBIDDEN";
    public static final String ERR_NOT_FOUND = "ERR-NOT-FOUND";
    public static final String ERR_CONFLICT = "ERR-CONFLICT";
    public static final String ERR_TOO_MANY_REQUESTS = "ERR-TOO-MANY-REQUESTS";
    public static final String ERR_UNAVAILABLE = "ERR-UNAVAILABLE";
    public static final String ERR_DEPENDENCY = "ERR-DEPENDENCY";
    public static final String ERR_UNSUPPORTED_API_VERSION = "ERR-UNSUPPORTED-API-VERSION";
    public static final String ERR_INTERNAL = "ERR-INTERNAL";

    // Message templates.
    public static final String RESOURCE_NOT_FOUND = "{0} with id ''{1}'' was not found.";
    public static final String VERSION_CONFLICT = "{0} ''{1}'' was modified concurrently.";
    public static final String INVALID_FIELD = "Field ''{0}'' is invalid: {1}";
    public static final String ACCESS_DENIED = "Access denied to ''{0}''.";
    public static final String CALLER_CONTEXT_NOT_FOUND = "No caller context could be resolved.";
    public static final String UNRECOGNIZED_CALLER_CONTEXT = "Unrecognized caller context: {0}";
    public static final String RATE_LIMIT_EXCEEDED = "Rate limit exceeded; retry after {0} seconds.";
    public static final String DEPENDENCY_UNAVAILABLE = "Downstream dependency {0} is unavailable.";
    public static final String DEPENDENCY_CALL_FAILED = "Call to {0} failed with status {1}.";
    public static final String UNSUPPORTED_API_VERSION = "Unsupported API version. Supported versions: {0}";

    public static NotFoundException resourceNotFound(String type, String id) {
        return new NotFoundException(ERR_NOT_FOUND, MessageFormat.format(RESOURCE_NOT_FOUND, type, id));
    }
    public static ConflictException versionConflict(String type, String id) {
        return new ConflictException(ERR_CONFLICT, MessageFormat.format(VERSION_CONFLICT, type, id));
    }
    public static BadRequestException invalidField(String field, String reason) {
        return new BadRequestException(ERR_BAD_REQUEST, MessageFormat.format(INVALID_FIELD, field, reason));
    }
    public static ForbiddenException accessDenied(String action) {
        return new ForbiddenException(ERR_FORBIDDEN, MessageFormat.format(ACCESS_DENIED, action));
    }
    public static ForbiddenException callerContextNotFound() {
        return new ForbiddenException(ERR_FORBIDDEN, CALLER_CONTEXT_NOT_FOUND);
    }
    public static ForbiddenException unrecognizedCallerContext(Object context) {
        return new ForbiddenException(ERR_FORBIDDEN, MessageFormat.format(UNRECOGNIZED_CALLER_CONTEXT, context));
    }
    public static TooManyRequestsException rateLimitExceeded(long retryAfterSeconds) {
        return new TooManyRequestsException(ERR_TOO_MANY_REQUESTS,
            MessageFormat.format(RATE_LIMIT_EXCEEDED, String.valueOf(retryAfterSeconds)), Duration.ofSeconds(retryAfterSeconds));
    }
    /** {@code dependency} is our own name for the downstream (e.g. "foo"), never text from its response. */
    public static UnavailableException dependencyUnavailable(String dependency, Throwable cause) {
        return new UnavailableException(ERR_UNAVAILABLE, MessageFormat.format(DEPENDENCY_UNAVAILABLE, dependency), cause);
    }
    /** Unexpected non-2xx that is not an outage; the status is ours to log, the response body never goes in the message. */
    public static DependencyException dependencyCallFailed(String dependency, int status) {
        return new DependencyException(ERR_DEPENDENCY, MessageFormat.format(DEPENDENCY_CALL_FAILED, dependency, String.valueOf(status)));
    }
    /** Lists the supported versions (e.g. Arrays.toString(ApiVersion.values())); never echoes the caller's raw input. */
    public static UnsupportedApiVersionException unsupportedApiVersion(String supportedVersions) {
        return new UnsupportedApiVersionException(ERR_UNSUPPORTED_API_VERSION,
            MessageFormat.format(UNSUPPORTED_API_VERSION, supportedVersions));
    }
}
