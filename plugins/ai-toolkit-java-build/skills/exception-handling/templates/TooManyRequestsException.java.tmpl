public class TooManyRequestsException extends BaseDomainException {
    public TooManyRequestsException(String errorCode, String message) { super(errorCode, message); }
    public TooManyRequestsException(String errorCode, String message, Throwable cause) { super(errorCode, message, cause); }
}
