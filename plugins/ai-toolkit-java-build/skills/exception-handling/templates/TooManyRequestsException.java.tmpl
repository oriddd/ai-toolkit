package {{basePackage}}.exception;
import org.jspecify.annotations.Nullable;
import java.time.Duration;
import java.util.Optional;
/** Maps to 429 — the caller exceeded its rate limit. An optional retryAfter becomes the Retry-After header. */
public class TooManyRequestsException extends BaseDomainException {
    private final Duration retryAfter;
    public TooManyRequestsException(String errorCode, String message) { this(errorCode, message, Duration.ZERO); }
    public TooManyRequestsException(String errorCode, String message, @Nullable Throwable cause) { this(errorCode, message, cause, Duration.ZERO); }
    public TooManyRequestsException(String errorCode, String message, Duration retryAfter) {
        super(errorCode, message);
        this.retryAfter = retryAfter;
    }
    public TooManyRequestsException(String errorCode, String message, @Nullable Throwable cause, Duration retryAfter) {
        super(errorCode, message, cause);
        this.retryAfter = retryAfter;
    }
    /** Empty when the thrower did not know how long to wait; the advice then sends its default. */
    public Optional<Duration> getRetryAfter() {
        return retryAfter.isZero() || retryAfter.isNegative() ? Optional.empty() : Optional.of(retryAfter);
    }
}
