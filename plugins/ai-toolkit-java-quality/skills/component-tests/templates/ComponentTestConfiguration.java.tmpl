package {{basePackage}}.testconfig;

import org.springframework.boot.test.context.TestConfiguration;
import org.springframework.boot.test.web.client.TestRestTemplate;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Primary;
import org.springframework.context.annotation.Profile;
import org.springframework.http.client.SimpleClientHttpRequestFactory;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;   // [security]
import org.springframework.security.config.annotation.web.configurers.AbstractHttpConfigurer;   // [security]
import org.springframework.security.web.SecurityFilterChain;   // [security]
import org.springframework.transaction.PlatformTransactionManager;   // [persistence]
import org.springframework.transaction.TransactionDefinition;   // [persistence]
import org.springframework.transaction.support.AbstractPlatformTransactionManager;   // [persistence]
import org.springframework.transaction.support.DefaultTransactionStatus;   // [persistence]
import org.springframework.transaction.support.TransactionSynchronizationManager;   // [persistence]

import java.time.Duration;

import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.*;

@TestConfiguration
@Profile("component-test")
public class ComponentTestConfiguration {

    // [security:begin]
    // Must be the only SecurityFilterChain: annotate the production security
    // config with @Profile("!component-test"), otherwise Spring Security 6
    // fails at startup (two any-request chains) or the production chain wins.
    @Bean
    public SecurityFilterChain testSecurityFilterChain(final HttpSecurity http) throws Exception {
        http.csrf(AbstractHttpConfigurer::disable)
            .authorizeHttpRequests(auth -> auth.anyRequest().permitAll());
        return http.build();
    }
    // [security:end]

    // [persistence:begin]
    // The component-test profile excludes the DataSource and JPA auto-configuration, which also removes the only
    // PlatformTransactionManager: @Transactional beans and an injected TransactionTemplate (messaging consumers)
    // fail at startup without one. The fakes hold the state, so there is nothing to begin, commit or roll back;
    // isExistingTransaction keeps Propagation.MANDATORY (OutboxWriter) and REQUIRED joining the caller's transaction.
    @Bean
    public PlatformTransactionManager noOpTransactionManager() {
        return new AbstractPlatformTransactionManager() {
            @Override
            protected Object doGetTransaction() {
                return new Object();
            }

            @Override
            protected boolean isExistingTransaction(final Object transaction) {
                return TransactionSynchronizationManager.isActualTransactionActive();
            }

            @Override
            protected void doBegin(final Object transaction, final TransactionDefinition definition) {}

            @Override
            protected void doCommit(final DefaultTransactionStatus status) {}

            @Override
            protected void doRollback(final DefaultTransactionStatus status) {}
        };
    }
    // [persistence:end]

    @Bean
    @Primary
    public TestRestTemplate testRestTemplate() {
        final SimpleClientHttpRequestFactory rf = new SimpleClientHttpRequestFactory();
        rf.setConnectTimeout(Duration.ofMinutes(2));
        rf.setReadTimeout(Duration.ofMinutes(2));
        final TestRestTemplate t = new TestRestTemplate();
        t.getRestTemplate().setRequestFactory(rf);
        return t;
    }

