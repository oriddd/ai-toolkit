package {{basePackage}}.architecture;
import com.tngtech.archunit.core.domain.JavaClass;
import com.tngtech.archunit.core.domain.JavaMethod;
import com.tngtech.archunit.core.domain.properties.HasAnnotations;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchCondition;
import com.tngtech.archunit.lang.ArchRule;
import com.tngtech.archunit.lang.ConditionEvents;
import com.tngtech.archunit.lang.SimpleConditionEvent;
import com.tngtech.archunit.core.importer.ImportOption;
import java.util.Arrays;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.methods;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;
import static com.tngtech.archunit.library.Architectures.layeredArchitecture;
import static com.tngtech.archunit.library.dependencies.SlicesRuleDefinition.slices;
@AnalyzeClasses(packages = "{{basePackage}}", importOptions = ImportOption.DoNotIncludeTests.class)
class ArchitectureTest {
    private static final String TRANSACTIONAL = "org.springframework.transaction.annotation.Transactional";
    @ArchTest
    static final ArchRule controllers_never_touch_repositories =
        noClasses().that().resideInAPackage("..controller..")
            .should().dependOnClassesThat().resideInAPackage("..repository..")
            .allowEmptyShould(true);   // ArchUnit 1.x fails a rule whose that() matches nothing: no controller/ yet, or none at all
    @ArchTest
    static final ArchRule services_never_depend_on_controllers =
        noClasses().that().resideInAPackage("..service..")
            .should().dependOnClassesThat().resideInAPackage("..controller..")
            .allowEmptyShould(true);
    @ArchTest
    static final ArchRule layered =
        // only dependencies between two layers are checked, so config/, adapter/, spi/, acl/, domain/, event/ … are not flagged
        layeredArchitecture().consideringOnlyDependenciesInLayers()
            .optionalLayer("Controller").definedBy("..controller..")   // optional: event-driven / scheduler services have none
            .optionalLayer("Operation").definedBy("..operation..")
            .optionalLayer("Service").definedBy("..service..")   // optional: an empty skeleton / thin consumer has none yet
            .optionalLayer("Repository").definedBy("..repository..")
            .optionalLayer("Scheduler").definedBy("..scheduler..")
            .optionalLayer("Health").definedBy("..health..")
            // project-types renames (event-driven / scheduler services), anchored at the base package so
            // client/<dep>/…/handler/ sub-packages are not mistaken for these layers; messaging/outbox/ is not a layer
            .optionalLayer("Consumer").definedBy("{{basePackage}}.messaging.consumer..")
            .optionalLayer("Handler").definedBy("{{basePackage}}.handler..")
            .optionalLayer("Job").definedBy("{{basePackage}}.job..")
            .optionalLayer("Producer").definedBy("{{basePackage}}.messaging.producer..")
            .optionalLayer("Client").definedBy("..client..")   // optional: no client/ when the service calls no HTTP downstream (create-repo #11)
            .whereLayer("Controller").mayNotBeAccessedByAnyLayer()
            .whereLayer("Consumer").mayNotBeAccessedByAnyLayer()
            .whereLayer("Operation").mayOnlyBeAccessedByLayers("Controller")
            .whereLayer("Handler").mayOnlyBeAccessedByLayers("Consumer")
            .whereLayer("Job").mayOnlyBeAccessedByLayers("Scheduler")
            .whereLayer("Service").mayOnlyBeAccessedByLayers("Controller", "Operation", "Scheduler", "Consumer", "Handler", "Job")
            .whereLayer("Repository").mayOnlyBeAccessedByLayers("Service", "Operation", "Scheduler", "Handler", "Job")
            .whereLayer("Producer").mayOnlyBeAccessedByLayers("Service", "Operation", "Handler", "Job")
            .whereLayer("Client").mayOnlyBeAccessedByLayers("Service", "Operation", "Repository", "Health", "Handler", "Job");
    @ArchTest
    static final ArchRule noCycles =
        // one slice per top-level package, but messaging/consumer and messaging/producer apart:
        // consumer -> handler/service -> producer is the normal flow, not a cycle
        slices().matching("{{basePackage}}.(messaging.*|*)..").should().beFreeOfCycles()
            .allowEmptyShould(true);   // a fresh skeleton has only the application class, so there are no slices yet
    @ArchTest
    static final ArchRule controllersAreNamedController =
        classes().that().resideInAPackage("..controller..")
            .should().haveSimpleNameEndingWith("Controller")
            .allowEmptyShould(true);
    @ArchTest
    static final ArchRule controllersAreThin =
        noClasses().that().resideInAPackage("..controller..")
            .should().dependOnClassesThat().resideInAPackage("..client..")
            .allowEmptyShould(true);
    @ArchTest
    static final ArchRule webClientLivesInClientOnly =
        // HTTP-client packages only in client/ (wrappers), adapter/ (HTTP vendor adapters), config/ and health/ (bean wiring)
        noClasses().that().resideOutsideOfPackages("..client..", "..adapter..", "..config..", "..health..")
            .should().dependOnClassesThat().resideInAnyPackage(
                "org.springframework.web.reactive.function.client..",
                "org.springframework.web.client..");
    @ArchTest
    static final ArchRule securityHolderLivesInPermissionOnly =
        // the JPA AuditorAware (persistence SecurityAuditorAware) lives in permission/ too; config/AuditConfig only enables auditing
        noClasses().that().resideOutsideOfPackage("..permission..")
            .should().dependOnClassesThat().haveFullyQualifiedName("org.springframework.security.core.context.SecurityContextHolder");
    @ArchTest
    static final ArchRule transactionalMethodsRollBackOnEveryException =
        // domain exceptions are checked and Spring rolls back on unchecked ones only (exception-handling §1a)
        methods().that().areAnnotatedWith(TRANSACTIONAL)
            .should(new ArchCondition<JavaMethod>("declare rollbackFor = Exception.class") {
                @Override
                public void check(JavaMethod method, ConditionEvents events) {
                    boolean ok = rollsBackOnEveryException(method);
                    events.add(new SimpleConditionEvent(method, ok, method.getDescription() + (ok ? " rolls back on every exception" : " lacks rollbackFor = Exception.class")));
                }
            })
            .allowEmptyShould(true);   // a service without persistence has no @Transactional
    @ArchTest
    static final ArchRule transactionalClassesRollBackOnEveryException =
        classes().that().areAnnotatedWith(TRANSACTIONAL)
            .should(new ArchCondition<JavaClass>("declare rollbackFor = Exception.class") {
                @Override
                public void check(JavaClass type, ConditionEvents events) {
                    boolean ok = rollsBackOnEveryException(type);
                    events.add(new SimpleConditionEvent(type, ok, type.getDescription() + (ok ? " rolls back on every exception" : " lacks rollbackFor = Exception.class")));
                }
            })
            .allowEmptyShould(true);
    private static boolean rollsBackOnEveryException(HasAnnotations<?> annotated) {
        return annotated.getAnnotationOfType(TRANSACTIONAL).get("rollbackFor")
            .map(value -> Arrays.stream((JavaClass[]) value)
                .anyMatch(type -> type.isEquivalentTo(Exception.class) || type.isEquivalentTo(Throwable.class)))
            .orElse(false);
    }
}
